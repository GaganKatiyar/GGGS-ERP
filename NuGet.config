<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Cleared first so a developer's machine-wide feeds cannot change what this repo restores.
    Central Package Management also requires source mapping once more than one source exists.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <config>
    <add key="globalPackagesFolder" value="%USERPROFILE%\.nuget\packages" />
  </config>

</configuration>
