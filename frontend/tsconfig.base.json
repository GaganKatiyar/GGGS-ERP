{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@gggs/core/auth": ["./libs/core/auth/src/index.ts"],
      "@gggs/core/tenant": ["./libs/core/tenant/src/index.ts"],
      "@gggs/core/permissions": ["./libs/core/permissions/src/index.ts"],
      "@gggs/core/http": ["./libs/core/http/src/index.ts"],
      "@gggs/core/layout": ["./libs/core/layout/src/index.ts"],
      "@gggs/shared/ui": ["./libs/shared/ui/src/index.ts"],
      "@gggs/shared/models": ["./libs/shared/models/src/index.ts"],
      "@gggs/shared/data-table": ["./libs/shared/data-table/src/index.ts"],
      "@gggs/features/dashboard": ["./libs/features/dashboard/src/index.ts"],
      "@gggs/features/organization": [
        "./libs/features/organization/src/index.ts"
      ],
      "@gggs/features/employees": ["./libs/features/employees/src/index.ts"],
      "@gggs/shared/org-reference": [
        "./libs/shared/org-reference/src/index.ts"
      ],
      "@gggs/features/admin": ["./libs/features/admin/src/index.ts"],
      "@gggs/shared/identity": ["./libs/shared/identity/src/index.ts"],
      "@gggs/shared/documents": ["./libs/shared/documents/src/index.ts"],
      "@gggs/shared/notifications": ["./libs/shared/notifications/src/index.ts"],
      "@gggs/features/notifications": ["./libs/features/notifications/src/index.ts"],
      "@gggs/features/leave": ["./libs/features/leave/src/index.ts"],
      "@gggs/features/workflow": ["./libs/features/workflow/src/index.ts"],
      "@gggs/features/attendance": ["./libs/features/attendance/src/index.ts"],
      "@gggs/shared/employee-reference": [
        "./libs/shared/employee-reference/src/index.ts"
      ],
      "@gggs/features/reports": ["./libs/features/reports/src/index.ts"],
      "@gggs/features/recruitment": [
        "./libs/features/recruitment/src/index.ts"
      ],
      "@gggs/features/onboarding": [
        "./libs/features/onboarding/src/index.ts"
      ],
      "@gggs/features/performance": [
        "./libs/features/performance/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
