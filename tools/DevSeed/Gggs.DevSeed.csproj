  <ItemGroup>
    <ProjectReference Include="..\..\backend\Data\Gggs.Data.Migrations\Gggs.Data.Migrations.csproj" />
    <ProjectReference Include="..\..\backend\Host\Gggs.Composition\Gggs.Composition.csproj" />
  </ItemGroup>

</Project>
