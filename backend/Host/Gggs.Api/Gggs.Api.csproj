<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Gggs.Api</RootNamespace>
    <UserSecretsId>gggs-api</UserSecretsId>
    <Description>PeopleOS: the one web host. Serves the API, the OIDC endpoints, the browser session endpoints and the SPA from a single origin (ADR-12).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\Gggs.BuildingBlocks.Observability\Gggs.BuildingBlocks.Observability.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Gggs.BuildingBlocks.Secrets\Gggs.BuildingBlocks.Secrets.csproj" />
    <ProjectReference Include="..\Gggs.Composition\Gggs.Composition.csproj" />
    <!-- Loaded at runtime by EF (pending-migration checks); see DataExtensions.MigrationsAssembly. -->
    <ProjectReference Include="..\..\Data\Gggs.Data.Migrations\Gggs.Data.Migrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gggs.Api.IntegrationTests" />
  </ItemGroup>

</Project>
