{
  "ConnectionStrings": {
    "AppDb": "Server=localhost;Database=peopleos;Integrated Security=True;TrustServerCertificate=True;Encrypt=False"
  },
  "Gggs": {
    "Platform": {
      // Local development runs the on-premise profile: no Key Vault, no Azure credentials needed
      // to sign in on a laptop, and those adapters get exercised every day.
      "DeploymentProfile": "OnPremise"
    },
    "Security": {
      "EnforceStepUp": false
    },
    "Storage": {
      // Uploaded documents, one folder per tenant. Shared by the API (uploads) and the worker.
      "FileSystem": {
        "RootPath": "../../../.local/files"
      }
    },
    "Notifications": {
      "AppBaseUrl": "http://localhost:4200",
      "EmailProvider": "Log"
    },
    "Secrets": {
      "File": {
        "FilePath": "../../../.local/secrets/api-secrets.protected.json"
      }
    }
  }
}
