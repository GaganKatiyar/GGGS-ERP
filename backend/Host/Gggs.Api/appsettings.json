{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "AppDb": "",
    "Redis": ""
  },
  "Gggs": {
    "Platform": {
      "DeploymentProfile": "Cloud"
    },
    "Security": {
      "StepUpWindow": "00:15:00",
      "EnforceStepUp": true
    },
    "SecurityHeaders": {
      "EnableHsts": true,
      "AdditionalConnectSources": ""
    },
    "Bff": {
      "Session": {
        "IdleTimeout": "00:30:00",
        "AbsoluteTimeout": "12:00:00",
        "BindToUserAgent": true,
        "RevalidateInterval": "00:05:00"
      }
    },
    "Identity": {
      "Tokens": {
        "Issuer": "",
        "AccessTokenLifetime": "00:10:00",
        "RefreshTokenLifetime": "12:00:00",
        "GatewayClientId": "peopleos-api",
        "GatewayClientSecret": "",
        "SigningCertificateThumbprint": "",
        "EncryptionCertificateThumbprint": ""
      }
    }
  }
}
