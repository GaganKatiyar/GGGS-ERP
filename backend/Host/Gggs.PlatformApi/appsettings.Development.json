{
  "ConnectionStrings": {
    // The HR application's database: organisations created here are the HR app's tenants.
    "AppDb": "Server=localhost;Database=peopleos;Integrated Security=True;TrustServerCertificate=True;Encrypt=False"
  },
  "Gggs": {
    "Platform": {
      "DeploymentProfile": "OnPremise"
    },
    "Security": {
      "EnforceStepUp": false
    },
    "Identity": {
      "PlatformBootstrap": {
        // Development only. Opens http://127.0.0.1:4300/setup while no platform staff exist.
        "SetupKey": "local-platform-setup"
      }
    },
    "Storage": {
      "FileSystem": {
        "RootPath": "../../../.local/files"
      }
    },
    "Notifications": {
      // Links in emails sent from here (an organisation administrator's invitation) open the HR app.
      "AppBaseUrl": "http://localhost:4200",
      "EmailProvider": "Log"
    },
    "Secrets": {
      "File": {
        "FilePath": "../../../.local/secrets/api-secrets.protected.json"
      }
    }
  }
}
