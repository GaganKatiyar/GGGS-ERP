<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Gggs.PlatformApi</RootNamespace>
    <UserSecretsId>gggs-platform-api</UserSecretsId>
    <Description>Nuts and Bolts platform console server: organisations, subscriptions, platform staff and health for GGGS's own staff. Hosted apart from the HR application; shares only its database.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\BuildingBlocks\Gggs.BuildingBlocks.Jobs\Gggs.BuildingBlocks.Jobs.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Gggs.BuildingBlocks.Files\Gggs.BuildingBlocks.Files.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Gggs.BuildingBlocks.Observability\Gggs.BuildingBlocks.Observability.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\Gggs.BuildingBlocks.Secrets\Gggs.BuildingBlocks.Secrets.csproj" />
    <ProjectReference Include="..\Gggs.Composition\Gggs.Composition.csproj" />
    <!-- Loaded at runtime by EF (pending-migration checks); see DataExtensions.MigrationsAssembly. -->
    <ProjectReference Include="..\..\Data\Gggs.Data.Migrations\Gggs.Data.Migrations.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gggs.Api.IntegrationTests" />
  </ItemGroup>

</Project>
