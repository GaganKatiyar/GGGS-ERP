{
  "ConnectionStrings": {
    "AppDb": "Server=localhost;Database=peopleos;Integrated Security=True;TrustServerCertificate=True;Encrypt=False"
  },
  "Gggs": {
    "Platform": {
      "DeploymentProfile": "OnPremise"
    },
    "Storage": {
      // Uploaded documents, one folder per tenant. Shared by the API (uploads) and the worker.
      "FileSystem": {
        "RootPath": "../../../.local/files"
      }
    },
    "Notifications": {
      "AppBaseUrl": "http://localhost:4200",
      "EmailProvider": "Log"
    },
    "Secrets": {
      "File": {
        "FilePath": "../../../.local/secrets/worker-secrets.protected.json"
      }
    }
  }
}
