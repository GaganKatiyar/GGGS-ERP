{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "NotificationDb": "Server=localhost;Database=gggs_notification;Integrated Security=True;TrustServerCertificate=True;Encrypt=False"
  },
  "Gggs": {
