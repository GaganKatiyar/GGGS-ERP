{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TimeDb": ""
  },
  "Gggs": {
    "Platform": {
      "DeploymentProfile": "Cloud"
    },
    "Security": {
      "StepUpWindow": "00:15:00",
      "EnforceStepUp": true
    },
    "Authentication": {
      "Authority": "https://identity.gggshr.local",
      "Audience": "gggs.api",
      "AllowHttpMetadata": false
    },
    "Services": {
      "Identity": "http://identity"
    },
    "Messaging": {
      "TopicName": "gggs-events",
      "SubscriptionName": "time"
    }
  }
}
