{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "ConnectionStrings": {
    "SampleDb": "Server=localhost;Database=gggs_sample;Integrated Security=True;TrustServerCertificate=True;Encrypt=False"
  },
  "Gggs": {
    "Platform": {
      // Local development runs the on-premise profile: no Key Vault, no Blob Storage, no Azure
      // credentials needed to start the service. It also means the on-premise adapters are
      // exercised every day rather than only when someone builds a customer install.
      "DeploymentProfile": "OnPremise"
    },
    "Security": {
      "EnforceStepUp": false
    },
    "Storage": {
      "FileSystem": {
        "RootPath": "../../../../.local/storage"
      }
    },
    "Secrets": {
      "File": {
        "FilePath": "../../../../.local/secrets/secrets.protected.json"
      }
    },
    "Cache": {
      "Environment": "local"
    },
    "Tenants": {
      "Tenants": [
        {
          "Id": "11111111-1111-1111-1111-111111111111",
          "Code": "acme",
          "Name": "Acme Manufacturing",
          "Status": "Active",
          "IsolationTier": "Pooled",
          "DataRegion": "centralindia",
          "CountryCode": "IN",
          "DefaultTimeZone": "Asia/Kolkata",
          "DefaultCurrency": "INR",
          "DefaultLocale": "en-IN"
        },
        {
          "Id": "22222222-2222-2222-2222-222222222222",
          "Code": "globex",
          "Name": "Globex Services",
          "Status": "Active",
          "IsolationTier": "Pooled",
          "DataRegion": "centralindia",
          "CountryCode": "IN",
          "DefaultTimeZone": "Asia/Kolkata",
          "DefaultCurrency": "INR",
          "DefaultLocale": "en-IN"
        }
      ]
    }
  }
}
