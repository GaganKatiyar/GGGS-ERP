{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "PlatformDb": "Server=localhost;Database=gggs_platform;Integrated Security=True;TrustServerCertificate=True;Encrypt=False"
  },
  "Gggs": {
    "Platform": {
      "DeploymentProfile": "OnPremise"
    },
    "Security": {
      "EnforceStepUp": false
    },
    "Secrets": {
      "File": {
        "FilePath": "../../../../.local/secrets/platform-secrets.protected.json"
      }
    },
    "Authentication": {
      // Tokens are validated against Identity's real local address, not the container DNS name
      // ("http://identity") the cloud/compose config uses.
      "Authority": "http://localhost:5101",
      "Audience": "gggs.api",
      "AllowHttpMetadata": true
    },
    "Services": {
      "Identity": "http://localhost:5101"
    }
  }
}
