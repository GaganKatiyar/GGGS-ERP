{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "IdentityDb": "Server=localhost;Database=gggs_identity;Integrated Security=True;TrustServerCertificate=True;Encrypt=False"
  },
  "Gggs": {
    "Platform": {
      // Local development runs the on-premise profile, same reasoning as every other service:
      // no Key Vault, no Azure credentials needed to sign in on a laptop.
      "DeploymentProfile": "OnPremise"
    },
    "Security": {
      "EnforceStepUp": false
    },
    "Secrets": {
      "File": {
        "FilePath": "../../../../.local/secrets/identity-secrets.protected.json"
      }
    },
    "Services": {
      "Platform": "http://localhost:5102"
    }
  }
}
