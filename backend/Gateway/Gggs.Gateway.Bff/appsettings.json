{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": ""
  },
  "Gggs": {
    "Platform": {
      "DeploymentProfile": "Cloud"
    },
    "Services": {
      "Identity": "http://identity",
      "Platform": "http://platform",
      "CoreHr": "http://corehr",
      "Documents": "http://documents",
      "Notification": "http://notification",
      "Workflow": "http://workflow",
      "Time": "http://time",
      "Talent": "http://talent"
    },
    "Bff": {
      "Identity": {
        "ClientId": "gggs-bff",
        "ClientSecret": ""
      },
      "SecurityHeaders": {
        "EnableHsts": true,
        "AdditionalConnectSources": ""
      },
      "Session": {
        "IdleTimeout": "00:30:00",
        "AbsoluteTimeout": "12:00:00",
        "BindToUserAgent": true,
        "RefreshMargin": "00:01:00"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
