{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": ""
  },
  "Gggs": {
    "Platform": {
      "DeploymentProfile": "Cloud"
    },
    "Services": {
      "Identity": "http://identity"
    },
    "Bff": {
      "SecurityHeaders": {
        "EnableHsts": true,
        "AdditionalConnectSources": ""
      },
      "Session": {
        "IdleTimeout": "00:30:00",
        "AbsoluteTimeout": "12:00:00",
        "BindToUserAgent": true
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-me": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/me/{**catch-all}" }
      },
      "identity-users": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/users/{**catch-all}" }
      },
      "identity-roles": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/roles/{**catch-all}" }
      },
      "identity-permissions": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/permissions/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": { "Address": "http://identity" }
        }
      }
    }
  }
}
