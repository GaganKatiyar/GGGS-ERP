{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Redis": ""
  },
  "Gggs": {
    "Platform": {
      "DeploymentProfile": "Cloud"
    },
    "Services": {
      "Identity": "http://identity",
      "Platform": "http://platform"
    },
    "Bff": {
      "Identity": {
        "ClientId": "gggs-bff",
        "ClientSecret": ""
      },
      "SecurityHeaders": {
        "EnableHsts": true,
        "AdditionalConnectSources": ""
      },
      "Session": {
        "IdleTimeout": "00:30:00",
        "AbsoluteTimeout": "12:00:00",
        "BindToUserAgent": true,
        "RefreshMargin": "00:01:00"
      }
    }
  },
  "ReverseProxy": {
    "Routes": {
      "identity-me": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/me/{**catch-all}" }
      },
      "identity-users": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/users/{**catch-all}" }
      },
      "identity-roles": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/roles/{**catch-all}" }
      },
      "identity-permissions": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/permissions/{**catch-all}" }
      },
      "identity-tenant-bootstrap": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/v1/tenants/{tenantId}/administrator-invitation" }
      },
      "platform-tenants": {
        "ClusterId": "platform",
        "Match": { "Path": "/api/v1/tenants/{**catch-all}" }
      },
      "platform-settings": {
        "ClusterId": "platform",
        "Match": { "Path": "/api/v1/settings/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": {
          "primary": { "Address": "http://identity" }
        }
      },
      "platform": {
        "Destinations": {
          "primary": { "Address": "http://platform" }
        }
      }
    }
  }
}
